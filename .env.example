# Copy this file to .env.local and fill in values. .env.local is gitignored.

# Required: a long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# --- Email one-time-code (OTP) via SMTP -------------------------------------
# Works with ANY SMTP provider — no custom domain needed.
#
# Gmail (free, recommended): enable 2-Step Verification, then create an
#   App Password (Google Account -> Security -> App passwords) and use it here.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   EMAIL_FROM=Capstone Portal <youraddress@gmail.com>
#
# SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASS=<api key>
# Brevo:    SMTP_HOST=smtp-relay.brevo.com  SMTP_USER=<login>  SMTP_PASS=<smtp key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=
EMAIL_FROM=Capstone Portal <no-reply@alionova.online>
LECTURER_EMAILS=
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Optional: comma-separated allowlist of emails permitted to sign in via OTP.
# Leave blank to allow any valid email.
ALLOWED_EMAILS=

# DEV ONLY: set to 1 to return the code in the API response and skip email.
# Never set this in production. Leave unset/blank normally.
AUTH_DEV_ECHO=


RESEND_API_KEY=
